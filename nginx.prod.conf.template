server {
    listen 80;
    add_header X-Content-Type-Options nosniff always;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;
    gzip_vary on;

    location ${BASE_PATH}assets/ {
        alias /usr/share/nginx/html${BASE_PATH}assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ${BASE_PATH} {
        alias /usr/share/nginx/html${BASE_PATH};
        try_files $uri $uri/ ${BASE_PATH}index.html;
    }
}
