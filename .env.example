# Parent directory of zarr datasets served by the local Tiled server (docker-compose's `tiled`
# service). Subfolders (sand, petiole, ...) show up directly as datasets - no registration step.
DATA_PATH=/path/to/your/zarr/data

# Tiled server URL/paths/default-dataset are NOT read from env vars - they're configured in
# src/tiledServers.ts (TILED_SERVERS), which the header dropdown switches between at runtime. Edit
# that file to change the local port/path, or the staging/production server addresses.

# --- Everything below is build-time only (consumed by vite.config.js / src/config.ts / read via
# `import.meta.env` in client code) - it has no effect on `docker compose up`'s dev workflow, since
# docker-compose.yml's `react` service always builds the Dockerfile's `dev` stage, which never
# receives these as build args. They're only relevant if you're running `npm run build`/`npm run dev`
# directly from source, or building a custom image yourself (`docker build --build-arg ...`). See
# docs/admin/deployment.md and docs/admin/configuring-tiled-servers.md for the full picture. ---

# The app's own served path (Vite's `base`). Must include both a leading and trailing slash.
# Defaults to /tomo_viewer/ (today's local-dev convention) when unset. NOTE: unlike the VITE_-
# prefixed vars below, Vite does NOT auto-load this one from a .env file into vite.config.js's own
# process.env - it only has an effect if actually exported in your shell before running npm run
# build/dev (`export BASE_PATH=... && npm run build`), or passed as a Docker --build-arg.
# BASE_PATH=/tomo_viewer/

# Lock the app to one Tiled server and hide the header's server dropdown entirely. Must be one of
# TILED_SERVERS' ids in src/tiledServers.ts (local | staging | production). Leave unset for the
# normal, fully-switchable dropdown (today's default local-dev behavior).
# VITE_FIXED_TILED_SERVER=

# URL of the documentation site, opened by the header's Docs button in an in-app iframe. Defaults to
# a same-origin relative path (`<base path>docs/`) - the docs are built into every published image
# alongside the app itself (see react/Dockerfile's `docs` stage), so this normally never needs
# setting. Only override it to point at a genuinely separately-hosted docs site, or set it to an
# empty string to hide the Docs button entirely.
# VITE_DOCS_URL=
