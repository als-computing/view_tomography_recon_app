{
  "name": "zarr-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebGPU OME-Zarr tomography volume renderer, embedded in the parent app's React viewer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.52",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
